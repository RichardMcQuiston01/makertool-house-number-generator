{
  "name": "@richardmcquiston01/house-number-generator",
  "version": "0.1.0",
  "description": "Generates SVG/DXF laser-cutter files for house number signs.",
  "keywords": [
    "house-number",
    "sign-generator",
    "laser-cutting",
    "svg",
    "dxf",
    "cnc",
    "cricut",
    "font"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "house-number-generator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/makertool-house-number-generator.git"
  },
  "homepage": "https://github.com/RichardMcQuiston01/makertool-house-number-generator#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/makertool-house-number-generator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "^2.9.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.1"
  }
}
